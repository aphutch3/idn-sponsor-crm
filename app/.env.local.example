NEXT_PUBLIC_SUPABASE_URL=https://wpgfanjopuupjcgrdbmb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LinkedIn monitoring worker ---
# Apify token for LinkedIn actors (company + profile pages). Required for
# LinkedIn monitoring — Firecrawl returns 403 on linkedin.com.
# Get one at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Optional: override the default LinkedIn actors.
# Defaults: automation-lab~linkedin-company-scraper, harvestapi~linkedin-profile-scraper
# APIFY_LINKEDIN_COMPANY_ACTOR=automation-lab~linkedin-company-scraper
# APIFY_LINKEDIN_PROFILE_ACTOR=harvestapi~linkedin-profile-scraper
# APIFY_LINKEDIN_COMPANY_URL_FIELD=companyUrls
# APIFY_LINKEDIN_PROFILE_URL_FIELD=urls
# APIFY_MAX_CHARGE_PER_CALL_USD=0.05

# Firecrawl API key — used for non-LinkedIn URLs (currently no fetch types use this,
# but kept for future expansion).
FIRECRAWL_API_KEY=

# Cron auth — the /api/cron/linkedin-monitor endpoint requires Authorization: Bearer $CRON_SECRET
CRON_SECRET=
